# A-Mem Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for OpenAI backend)
OPENAI_API_KEY=sk-your-api-key-here

# Doubao/豆包 settings (火山引擎 Ark API)
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2.0

# Ollama settings (if using Ollama backend)
OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM settings (if using LiteLLM backend)
LITELLM_API_BASE=
LITELLM_API_KEY=
